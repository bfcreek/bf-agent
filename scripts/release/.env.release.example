# Copy this file to scripts/release/.env.release (gitignored) for local releases.
# Existing shell environment variables take precedence over values in this file.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=halo-agent-releases

# npm Automation token — required only for production publish (publish-production.ps1)
# Create at npmjs.com → Access Tokens → Generate New Token:
#   Granular: Organizations halosoftworks (Read and write), scope @halosoftworks (Read and write),
#             enable "Bypass two-factor authentication (2FA)" for scripted publish.
#   Or Classic → Automation (bypasses 2FA; do not use "Publish" unless 2FA is enabled on the account).
NPM_TOKEN=

# Optional override for production CDN checks during npm publish
# HALO_AGENT_UPDATES_BASE_URL=https://halo-agent-releases.halosoftworks.com

# GitHub release (publish-npm.cjs, before npm publish):
#   GitHub CLI `gh` on PATH, authenticated with permission to create releases
#   on the repository in package.json (`gh auth login`). No token is read from this file.

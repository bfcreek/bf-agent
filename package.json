{
  "name": "@bitfieldcreek/bf-agent",
  "version": "1.1.25",
  "description": "Local-first agent runtime (Ollama default): plan/act/observe loop, tools, optional peer providers, and an OpenAI-compatible facade.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Bitfield Creek",
  "homepage": "https://www.bitfieldcreek.com/bf-agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bfcreek/bf-agent.git"
  },
  "bugs": {
    "url": "https://github.com/bfcreek/bf-agent/issues"
  },
  "keywords": [
    "ollama",
    "agent",
    "cli",
    "mcp",
    "openai",
    "anthropic",
    "copilot",
    "local-ai",
    "coding-agent",
    "local-llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "bf-agent": "src/cli.mjs"
  },
  "files": [
    "src/",
    "bin/bf-agent.cmd",
    "bin/bf-agent.ps1",
    "bin/bf-agent.sh",
    "README.md",
    "LIMITATIONS.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "serve": "node src/cli.mjs serve",
    "test": "node --test",
    "evals": "node evals/run.mjs",
    "bench": "node evals/dev-bench.mjs",
    "bench:patterns": "node evals/analyze-patterns.mjs",
    "bench:menu": "powershell -NoProfile -ExecutionPolicy Bypass -File bin/bench.ps1",
    "bench:local": "powershell -NoProfile -ExecutionPolicy Bypass -File bin/bench-local.ps1",
    "bench:recognized": "node evals/recognized/run.mjs",
    "bench:tb": "node evals/recognized/run.mjs terminal-bench",
    "bench:tb:mini": "node evals/recognized/run.mjs terminal-bench --sample 5",
    "bench:tb:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File bin/bench-tb.ps1",
    "bench:tb:mini:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File bin/bench-tb-mini.ps1",
    "bench:ha-train": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/commands/ha-train.ps1",
    "release:build": "node scripts/release/build-release-zip.cjs",
    "release:stage": "node scripts/release/stage-release-artifacts.cjs",
    "release:upload": "node scripts/release/upload-r2-release.cjs",
    "release:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/publish-release.ps1",
    "release:ha": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/commands/ha-release.ps1",
    "release:ha-npm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/commands/ha-release-npm.ps1",
    "release:npm": "node scripts/release/publish-npm.cjs",
    "release:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/publish-production.ps1"
  },
  "peerDependencies": {
    "openai": ">=4.0.0",
    "@anthropic-ai/sdk": ">=0.39.0",
    "@github/copilot-sdk": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "openai": { "optional": true },
    "@anthropic-ai/sdk": { "optional": true },
    "@github/copilot-sdk": { "optional": true }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.888.0"
  }
}

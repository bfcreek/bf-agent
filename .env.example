# Copy to .env (gitignored) and edit.
#   copy .env.example .env

HALO_MODEL=auto
HALO_PORT=11435
HALO_NUM_CTX=16384
OLLAMA_PORT=11434
HALO_WORKSPACE=./workspace
# Sibling of this repo — dev bench + Terminal-Bench reports (host path).
HALO_BENCHMARK_ROOT=../halo-agent-benchmark

# Used by: docker compose --profile pull up ollama-pull
HALO_PULL_MODEL=llama3.2
